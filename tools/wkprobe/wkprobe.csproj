<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build against a WolvenKit folder: dotnet build -p:WolvenKitDir=<folder> (or set WOLVENKIT_DIR). -->
    <WolvenKitDir Condition="'$(WolvenKitDir)' == ''">$(WOLVENKIT_DIR)</WolvenKitDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WolvenKit.RED4"><HintPath>$(WolvenKitDir)\WolvenKit.RED4.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.Common"><HintPath>$(WolvenKitDir)\WolvenKit.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.Core"><HintPath>$(WolvenKitDir)\WolvenKit.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WolvenKit.Modkit"><HintPath>$(WolvenKitDir)\WolvenKit.Modkit.dll</HintPath><Private>false</Private></Reference>
    <!-- WolvenKit's import argument types derive from its ObservableObject. -->
    <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(WolvenKitDir)\CommunityToolkit.Mvvm.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
